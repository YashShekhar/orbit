{
  "name": "orbit-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --import tsx --test \"tests/server/*.test.ts\"",
    "test:client": "vitest run",
    "test:production": "node --import tsx --test \"tests/runtime/*.test.ts\"",
    "test:watch": "vitest",
    "test:coverage": "npm run test:server:coverage && npm run test:client:coverage",
    "test:server:coverage": "c8 node --import tsx --test \"tests/server/*.test.ts\"",
    "test:client:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run test:production",
    "security:audit": "npm audit --audit-level=high",
    "prepare": "node scripts/install-hooks.ts"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "c8": {
    "all": true,
    "include": [
      "server/**/*.ts",
      "shared/**/*.ts"
    ],
    "exclude": [
      "server/index.ts",
      "server/routes/types.ts",
      "shared/types.ts"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "reports-dir": "coverage/server",
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 75,
    "statements": 80
  }
}
